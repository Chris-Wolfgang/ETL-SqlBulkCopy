<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Wolfgang.Etl.SqlBulkCopy.Examples.BulkLoadQuickstart</RootNamespace>
    <!-- Example code prioritizes readability over library-grade ceremony:
         it is not held to the strict warnings-as-errors bar the src/ and
         tests/ projects are. Consumers copy from these files, so ConfigureAwait
         noise, Console-localization rules, and similar library-only concerns
         are downgraded to plain warnings here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1303;CA2007;MA0004;MA0011;CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Etl.SqlBulkCopy\Wolfgang.Etl.SqlBulkCopy.csproj" />
  </ItemGroup>

</Project>
