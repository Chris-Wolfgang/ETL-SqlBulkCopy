{
  "stryker-config": {
    "project": "Wolfgang.Etl.SqlBulkCopy.csproj",
    "target-framework": "net10.0",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "ignore-mutations": [
      "string"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "GetCustomAttribute",
      "GetCustomAttribute<*>"
    ],
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 80
    }
  }
}
