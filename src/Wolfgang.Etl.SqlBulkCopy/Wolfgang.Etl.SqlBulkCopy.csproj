<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net481;netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.7.0</Version>
    <!-- AssemblyVersion tracks 0.{Minor} during 0.x (ADR-0011 in ETL-Abstractions).
         The minor is SemVer's breaking position pre-1.0, and AssemblyVersion is
         bind-time identity on net462/net481, so it MUST move with every minor —
         otherwise a binary-breaking change is invisible at bind time on .NET
         Framework and surfaces as a runtime MissingMethodException instead.
         Bump this together with <Version> in every release-prep PR. -->
    <AssemblyVersion>0.7.0</AssemblyVersion>
    <FileVersion>0.7.0</FileVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <!-- API/ABI compatibility gate (#88). On pack, the SDK's package validation
         (Microsoft.DotNet.ApiCompat) downloads the baseline release and fails
         the pack if the new public surface breaks binary/source compatibility
         in a way a non-MAJOR bump forbids. Keep the baseline at the last
         PUBLISHED version (see the PackageValidation baseline-timing note); bump
         it right after each release. Intentional MAJOR-release breaks are
         recorded via `dotnet pack -p:GenerateCompatibilitySuppressionFile=true`
         (writes CompatibilitySuppressions.xml). -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.6.0</PackageValidationBaselineVersion>
    <Title>Wolfgang.Etl.SqlBulkCopy</Title>
    <Authors>Chris Wolfgang</Authors>
    <Description>Loader implementation for bulk loading data into SQL Server using SqlBulkCopy, built on Wolfgang.Etl.Abstractions.</Description>
    <Copyright>Copyright 2026 Chris Wolfgang</Copyright>
    <PackageProjectUrl>https://github.com/Chris-Wolfgang/ETL-SqlBulkCopy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Chris-Wolfgang/ETL-SqlBulkCopy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>False</SignAssembly>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <PackageTags>ETL;Extract-Transform-Load;SqlBulkCopy;SQL-Server;Bulk-Load</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wolfgang.Etl.Abstractions" Version="0.22.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <!-- Source generator: built alongside the runtime, packed into the same
       NuGet under analyzers/dotnet/cs. PrivateAssets=all so consumers don't
       transitively reference the generator project. -->
  <ItemGroup>
    <ProjectReference Include="..\Wolfgang.Etl.SqlBulkCopy.SourceGenerator\Wolfgang.Etl.SqlBulkCopy.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackSourceGenerator" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\Wolfgang.Etl.SqlBulkCopy.SourceGenerator\bin\$(Configuration)\netstandard2.0\Wolfgang.Etl.SqlBulkCopy.SourceGenerator.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
