<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn source generators MUST target netstandard2.0 — analyzer
         host load contract. NOT multi-targeted. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- This project is NOT packed on its own — its DLL is embedded into
         the main Wolfgang.Etl.SqlBulkCopy NuGet under analyzers/dotnet/cs. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- Quieter analyzer set than the main src/ projects — source-gen code
         doesn't need to satisfy the runtime-library rule set. -->
    <!-- MA0028: interpolated StringBuilder.AppendLine calls — this is a
         source-emitting generator, not a runtime hot path, so the micro-opt
         does not apply. -->
    <NoWarn>$(NoWarn);RS1036;RS2008;NU1701;MA0028</NoWarn>

    <!-- No XML doc generation for the analyzer DLL. The user-facing API
         (BulkCopyableAttribute) lives in the main runtime assembly and is
         documented there. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- DO NOT BUMP without reading this.
         This DLL ships inside the Wolfgang.Etl.SqlBulkCopy package under
         analyzers/dotnet/cs and is loaded by the CONSUMER's compiler. A
         generator may only reference a Roslyn version LESS THAN OR EQUAL TO
         the compiler that loads it — otherwise every consumer whose SDK is
         older than that Roslyn gets a hard build error:

           CSC : error CS9057: Analyzer assembly '...SourceGenerator.dll'
           cannot be used because it references version '<X>' of the
           compiler, which is newer than the currently running version '<Y>'.

         So this pin is a COMPATIBILITY FLOOR, not a stale dependency: it sets
         the oldest SDK that can consume the package. 4.11.0 covers .NET 8 SDK
         / VS2022 17.11 and newer, which is the support range this package
         targets (its oldest TFM is net462, built by those SDKs).

         Dependabot raised this to 5.6.0 in the #256 group bump. That version
         requires a Roslyn 5.6 host — newer than the Roslyn 5.0.0 shipped in
         .NET SDK 10.0.111 — so the package built fine in CI (whose SDK is
         newer still) while breaking anyone on a current released SDK. CI
         cannot catch this class of regression, because CI is always on the
         newest SDK; see the dependabot.yml ignore that now holds the pin. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
