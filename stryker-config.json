{
  "stryker-config": {
    "project": "src/Wolfgang.Etl.SqlBulkCopy/Wolfgang.Etl.SqlBulkCopy.csproj",
    "test-projects": [
      "tests/Wolfgang.Etl.SqlBulkCopy.Tests.Unit/Wolfgang.Etl.SqlBulkCopy.Tests.Unit.csproj"
    ],
    "target-framework": "net10.0",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "ignore-mutations": [
      "string"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "GetCustomAttribute",
      "GetCustomAttribute<*>"
    ],
    "thresholds": {
      "high": 90,
      "low": 85,
      "break": 80
    }
  }
}
