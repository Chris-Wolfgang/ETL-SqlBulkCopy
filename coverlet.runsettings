<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/bin/**/*.cs;**/obj/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!--
            Exclude:
            - AutoGeneratedProgram: the implicit `<Main>$` entry point the
              .NET SDK emits for test projects. Never executed by user code
              and shows up as 0% in every test assembly.
            - *.TestModels.* across all assemblies: data-holder POCOs that
              exist to give tests a shape to populate. A property no test
              happens to read shouldn't count as a coverage gap; the
              test-assembly instrumentation below is for surfacing dead
              test *logic* (helpers, dead branches in test bodies), not
              dead POCO properties.
            - *Fixture (class-name ends in "Fixture"): xUnit collection
              fixtures whose catch paths are environment-dependent (e.g.
              SqlServerFixture's Docker-unavailable swallowing only fires
              on runners without Docker; on Linux Stage 1 the happy path
              runs and the catch body is unreachable). Gating these per-
              class at 90% would force pretending to test paths that
              can't actually fire in the runner's environment. The
              earlier draft of this filter used `*.Fixtures.*` which
              also swept in non-fixture helpers (AsyncEnumerableHelpers,
              TestSchema) that genuinely have logic worth covering —
              narrowed to a class-name pattern.
            - Wolfgang.Etl.SqlBulkCopy.Generated.*: source-GENERATOR OUTPUT,
              not hand-written code. The generator emits one
              BulkCopyAccessors_<mangled><hash> class per [BulkCopyable]
              type, holding a Get_<Property> thunk per column. A test that
              maps a fixture but never reads every column leaves some thunks
              unexecuted, which says nothing about the health of this repo —
              the thing that must be correct is the GENERATOR, and that is
              covered two ways that line coverage cannot improve on: the
              generator project itself is instrumented, and
              BulkCopyAccessorConformanceTests / DescriptorConformanceTests
              assert the generated map is identical to the reflection map.
              Note these classes dodge the two filters above by construction:
              they live in the .Generated namespace rather than *.TestModels.*,
              and their names end in the mangling hash, so `*Fixture` misses
              them even when the underlying model is a fixture.
              This is a filter of last resort — see the follow-up issue to have
              the generator emit [ExcludeFromCodeCoverage] on the types it
              produces, which fixes this at the source and stops our generated
              code polluting CONSUMERS' coverage reports too.
            Fakes are deliberately NOT excluded — they have logic that
            should be exercised by the tests using them.
          -->
          <Exclude>[*]AutoGeneratedProgram,[*]*.TestModels.*,[*]*Fixture,[*]Wolfgang.Etl.SqlBulkCopy.Generated.*</Exclude>
          <!--
            Instrument the test assembly itself in addition to the source
            assembly. Surfaces dead test helpers, unused fakes, and unused
            test-model branches so they can be cleaned up or covered. The
            ExcludeFromCodeCoverage attribute (when present) still opts a
            type out — the few legitimate cases (e.g. polyfill markers
            with no body) stay excluded.
          -->
          <IncludeTestAssembly>true</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
